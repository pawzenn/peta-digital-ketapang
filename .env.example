SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Alamat panel admin: RAHASIA (hanya developer yang tahu). Hubungi developer.
