APP_NAME="Peta Digital Desa Ketapang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
